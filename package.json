		"lib": "vue-cli-service build --target lib --name vue-super-player --dest lib packages/vue-super-player/index.js"
	},
	"dependencies": {
		"core-js": "^3.6.4",
		"vue": "^2.6.11",
		"vue-router": "^3.1.5",
		"vuex": "^3.1.2"
	},
	"devDependencies": {
		"@vue/cli-plugin-babel": "^4.2.0",
		"@vue/cli-plugin-eslint": "^4.2.0",
		"@vue/cli-plugin-router": "^4.2.0",
		"@vue/cli-plugin-vuex": "^4.2.0",
		"@vue/cli-service": "^4.2.0",
		"babel-eslint": "^10.0.3",
		"eslint": "^6.7.2",
		"eslint-plugin-vue": "^6.1.2",
		"node-sass": "^4.12.0",
		"sass-loader": "^8.0.2",
		"vue-template-compiler": "^2.6.11"
	},
	"eslintConfig": {
		"root": true,
		"env": {
			"node": true
		},
		"extends": [
