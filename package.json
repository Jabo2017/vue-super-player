{
	"name": "vue-super-player",
	"version": "1.0.5",
	"author": "Jabo",
	"description": "vue版本超级播放器",
	"keyword": "vue player",
	"main": "lib/vue-super-player.umd.min.js",
	"license": "MIT",
	"private": false,
	"scripts": {
		"serve": "vue-cli-service serve",
