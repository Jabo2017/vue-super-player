{
  "name": "vue-super-player",
  "version": "2.0.0",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "description": "多内核视频播放器组件（Vue 3 + TS）：原生 / hls.js / flv.js / Aliplayer 可插拔，自动检测播放格式",
  "keywords": [
    "vue",
    "vue3",
    "player",
    "video-player",
    "hls",
    "m3u8",
    "flv",
    "live",
    "aliplayer",
    "multi-kernel"
  ],
  "main": "./dist/vue-super-player.umd.cjs",
  "module": "./dist/vue-super-player.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-super-player.js",
      "require": "./dist/vue-super-player.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build",
    "build:demo": "vite build --config demo/vite.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "vue-aliplay-player": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.0"
  }
}
